    fn view(&self) -> Element<'_, Self::Message> {
        let row: cosmic::Element<'_, Msg> = cosmic::iced::widget::row![
            cosmic::widget::image(self.icon.clone()).width(24).height(24),
            // cosmic::iced::widget::text(&self.label).size(13.0),
        ]
        .spacing(6)
        .align_y(cosmic::iced::Alignment::Center)
        .into();

        self.core
            .applet
            .autosize_window(
                cosmic::widget::button::custom(row)
                    .class(cosmic::theme::Button::AppletIcon)
                    .on_press(Msg::TogglePopup),
            )
            .into()
    }

    fn view_window(&self, id: Id) -> Element<'_, Self::Message> {

        if Some(id) == self.popup {
            let content = cosmic::iced::widget::column![
                cosmic::iced::widget::text(&self.label).size(14.0),
                cosmic::iced::widget::rule::horizontal(2),
                cosmic::iced::widget::text(&self.phase_calendar_text).size(9.0),
                cosmic::iced::widget::rule::horizontal(2),
                cosmic::iced::widget::text(&self.phase_name).size(11.0),
            ]
            .spacing(4)
            .padding(8);

            self.core
                .applet
                .popup_container(content)
                .max_width(580.0)
                .into()
        } else {
            cosmic::iced::widget::text("").into()
        }
    }   
    fn subscription(&self) -> cosmic::iced::Subscription<Self::Message> {
        cosmic::iced::time::every(Duration::from_secs(1440)).map(|_| Msg::Tick)
    }
}

fn compute_label() -> (String, usize, String, String) {
    let phase: MoonPhase = ForDateTime::now();
    let phase_calendar: MoonCalendar = ForDateTime::now();
    

    let json_text = phase.to_json();
    let cal_json = phase_calendar.to_json();

    let parsed: serde_json::Value = match serde_json::from_str(&json_text) {
        Ok(v) => v,
        Err(_) => return ("🌑 Err".to_string(),1,"🌑 Err".to_string(),"🌑 Err".to_string()),
    };
    let cal_parsed: serde_json::Value = serde_json::from_str(&cal_json).unwrap_or_default();

    // 1. Extract numeric metrics from the root level
    let fraction_illuminated = parsed["fraction_illuminated"].as_f64().unwrap_or(0.0);
    let fraction_of_lunation = parsed["fraction_of_lunation"].as_f64().unwrap_or(0.0);
    let current_age = parsed["age"].as_f64().unwrap_or(0.0);

    // 2. Core Fix: Extract the native emoji string from the nested "phase" object
    let icon = parsed["phase"]["icon"].as_str().unwrap_or("🌙");

    let pct = fraction_illuminated * 100.0;
    
    // 3. Determine if the trajectory is Waxing (+) or Waning (-)
    let waxing = fraction_of_lunation < 0.5;
    // let sign = if waxing { "+" } else { "-" };
    // let sign = if waxing { "▲" } else { "▼" };
    // let sign = if waxing { "🔼" } else { "🔽" };
    // let sign = if waxing { "↑" } else { "↓" };
    let sign = if waxing { "↗" } else { "↘" };
    let next_state = if waxing { "Full Moon" } else { "New Moon" };

    // 4. Compute fractional days until the upcoming target extreme
    // Use exact Julian dates from MoonCalendar
    let current_jd = cal_parsed["julian_date"].as_f64().unwrap_or(0.0);
    let days_remaining = if waxing {
        cal_parsed["full_moon"].as_f64().unwrap_or(0.0) - current_jd
    } else {
        cal_parsed["next_new_moon"].as_f64().unwrap_or(0.0) - current_jd
    };

    let total_minutes = (days_remaining * 24.0 * 60.0).round() as i64;
    let d = total_minutes / (24 * 60);
    let h = (total_minutes / 60) % 24;
    let m = total_minutes % 60;

    let time_remaining_str = if d > 0 {
        format!("in {}d {}h {}m", d, h, m)
    } else if h > 0 {
        format!("in {}h {}m", h, m)
    } else if m > 0 {
        format!("in {} minutes", m)
    } else {
        format!("now!")
    };    

    let day = (current_age.round() as usize).clamp(1, 29);
    // 5. Format layout smoothly using the library's official matching emoji
    // let label = format!("{} {:.3}% ({} to {})", sign, pct, time_remaining_str,next_state);
    // let label = format!("{} {:.3}% {} {}", sign, pct,next_state , time_remaining_str);
    let label = format!("{} {}.\nThe moon is {:.3}% illuminated",next_state , time_remaining_str, pct);

    // The human-readable phase name from moontool's Display impl
    let phase_text = format!("{}", phase);
    let phase_calendar_text = format!("{}", phase_calendar);

    let clean: String = phase_calendar_text.chars().filter(|c| c.is_alphanumeric() || *c == ' '|| *c == '\n'|| *c == '\t').collect();   

    (label, day, phase_text, clean)
}


fn main() -> cosmic::iced::Result {
    cosmic::applet::run::<MoonApplet>(())
}   
