const APP_ID: &str = "com.example.CosmicAppletMoon";


#[derive(Debug, Clone)]
pub enum Msg {
    Tick,
}

macro_rules! moon_icons {
    ($day:expr, $($n:expr => $file:expr),*) => {
        match $day {
            $($n => cosmic::iced::widget::image::Handle::from_bytes(
                include_bytes!($file).to_vec()
            ),)*
            _ => cosmic::iced::widget::image::Handle::from_bytes(
                include_bytes!("../assets/icons/moon-1-NM.png").to_vec()
            ),
        }
    };
}

fn get_moon_phase_image(day: usize) -> cosmic::iced::widget::image::Handle {
    moon_icons!(day,
        1 => "../assets/icons/moon-1-NM.png",
        2 => "../assets/icons/moon-2.png",
        3 => "../assets/icons/moon-3.png",
        4 => "../assets/icons/moon-4.png",
        5 => "../assets/icons/moon-5.png",
        6 => "../assets/icons/moon-6.png",
        7 => "../assets/icons/moon-7.png",
        8 => "../assets/icons/moon-8-FQ.png",
        9 => "../assets/icons/moon-9.png",
        10 => "../assets/icons/moon-10.png",
        11 => "../assets/icons/moon-11.png",
        12 => "../assets/icons/moon-12.png",
        13 => "../assets/icons/moon-13.png",
        14 => "../assets/icons/moon-14.png",
        15 => "../assets/icons/moon-15-FM.png",
        16 => "../assets/icons/moon-16.png",
        17 => "../assets/icons/moon-17.png",
        18 => "../assets/icons/moon-18.png",
        19 => "../assets/icons/moon-19.png",
        20 => "../assets/icons/moon-20.png",
        21 => "../assets/icons/moon-21.png",
        22 => "../assets/icons/moon-22-LQ.png",
        23 => "../assets/icons/moon-23.png",
        24 => "../assets/icons/moon-24.png",
        25 => "../assets/icons/moon-25.png",
        26 => "../assets/icons/moon-26.png",
        27 => "../assets/icons/moon-27.png",
        28 => "../assets/icons/moon-28.png",
        29 => "../assets/icons/moon-29.png"
    )
}

// In your struct, store the handle:
pub struct MoonApplet {
    core: Core,
    label: String,
    icon: cosmic::iced::widget::image::Handle,
}

impl cosmic::Application for MoonApplet {
    type Executor = cosmic::executor::Default;
    type Flags = ();
    type Message = Msg;

    const APP_ID: &'static str = APP_ID;

    fn core(&self) -> &Core {
        &self.core
    }

    fn core_mut(&mut self) -> &mut Core {
        &mut self.core
    }


    fn init(core: Core, _flags: Self::Flags) -> (Self, Task<Action<Msg>>) {
        let label = compute_label().0;
        let day = compute_label().1;
        // In compute or init:
        let icon = get_moon_phase_image(day);           
        (Self { core, label, icon }, Task::none())
    }

    fn update(&mut self, _msg: Self::Message) -> Task<Action<Msg>> {
        let (label, day) = compute_label();
        self.label = label;
        self.icon = get_moon_phase_image(day); 
        Task::none()
    }

    // fn view(&self) -> Element<'_, Self::Message> {
    //     self.core
    //         .applet
    //         .autosize_window(
    //             self.core
    //                 .applet
    //                 .text_button(text(&self.label).size(12), Msg::Tick),
    //         )
    //         .into()
    // }     

    fn view(&self) -> Element<'_, Self::Message> {
        let row: cosmic::Element<'_, Msg> = cosmic::iced::widget::row![
            cosmic::widget::image(self.icon.clone()).width(24).height(24),
            cosmic::iced::widget::text(&self.label).size(13.0),
        ]
        .spacing(6)
        .align_y(cosmic::iced::Alignment::Center)
        .into();

    let bg: cosmic::Element<'_, Msg> = cosmic::iced::widget::container(row)
        .style(|_t: &cosmic::Theme| cosmic::iced::widget::container::Style {
            background: Some(cosmic::iced::Background::Color(
                cosmic::iced::Color::from_rgb8(20, 20, 20), // near-black
            )),
            text_color: Some(cosmic::iced::Color::WHITE),
            ..Default::default()
        })
        .padding([2.0, 6.0])
        .into();

        self.core
            .applet
            .autosize_window(bg)
            .into()
    }   

    fn subscription(&self) -> cosmic::iced::Subscription<Self::Message> {
        cosmic::iced::time::every(Duration::from_secs(1440)).map(|_| Msg::Tick)
    }
}

fn compute_label() -> (String, usize) {
    let phase: MoonPhase = ForDateTime::now();
    let json_text = phase.to_json();

    let parsed: serde_json::Value = match serde_json::from_str(&json_text) {
        Ok(v) => v,
        Err(_) => return ("🌑 Err".to_string(),1),
    };

    // 1. Extract numeric metrics from the root level
    let fraction_illuminated = parsed["fraction_illuminated"].as_f64().unwrap_or(0.0);
    let fraction_of_lunation = parsed["fraction_of_lunation"].as_f64().unwrap_or(0.0);
    let current_age = parsed["age"].as_f64().unwrap_or(0.0);

    // 2. Core Fix: Extract the native emoji string from the nested "phase" object
    let icon = parsed["phase"]["icon"].as_str().unwrap_or("🌙");

    let pct = fraction_illuminated * 100.0;
    
    // 3. Determine if the trajectory is Waxing (+) or Waning (-)
    let waxing = fraction_of_lunation < 0.5;
    // let sign = if waxing { "+" } else { "-" };
    // let sign = if waxing { "▲" } else { "▼" };
    // let sign = if waxing { "🔼" } else { "🔽" };
    // let sign = if waxing { "↑" } else { "↓" };
    let sign = if waxing { "↗" } else { "↘" };

    // 4. Compute fractional days until the upcoming target extreme
    let synodic_month = 29.530588853;
    let days_remaining = if waxing {
        (synodic_month / 2.0) - current_age 
    } else {
        synodic_month - current_age         
    };

    let total_minutes = (days_remaining * 24.0 * 60.0).round() as i64;
    let d = total_minutes / (24 * 60);
    let h = (total_minutes / 60) % 24;
    let m = total_minutes % 60;

    let time_remaining_str = if d > 0 {
        format!("{}d {}h {}m", d, h, m)
    } else {
        format!("{}h {}m", h, m)
    };    

    let day = (current_age.round() as usize).clamp(1, 29);
    // 5. Format layout smoothly using the library's official matching emoji
    let label = format!("{} {:.3}% (≈ {} left)", sign, pct, time_remaining_str);
    (label, day)
}


fn main() -> cosmic::iced::Result {
    cosmic::applet::run::<MoonApplet>(())
}   
